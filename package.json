{
  "name": "decant-core",
  "version": "1.8.0",
  "description": "A shared web extraction layer for AI conversations and regular web pages.",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "main": "ai/index.js",
  "exports": {
    ".": "./ai/index.js",
    "./ai/*": "./ai/*.js",
    "./web": "./web/index.js",
    "./web/*": "./web/*.js",
    "./article": "./web/article.js",
    "./detection/*": "./detection/*.js"
  },
  "files": [
    "ai",
    "web",
    "detection",
    "lib",
    "utils",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Covai-Labs/decant-core.git"
  },
  "bugs": {
    "url": "https://github.com/Covai-Labs/decant-core/issues"
  },
  "homepage": "https://github.com/Covai-Labs/decant-core#readme",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "ai",
    "chat",
    "parser",
    "chatgpt",
    "claude",
    "gemini",
    "deepseek",
    "copilot",
    "perplexity",
    "web-clipper",
    "extraction",
    "markdown",
    "readability",
    "turndown",
    "browser-extension",
    "scraping"
  ],
  "author": "deadrat-in",
  "license": "AGPL-3.0-only",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@extractus/article-extractor": "^9.0.1",
    "@mozilla/readability": "^0.6.0",
    "defuddle": "^0.19.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "linkedom": "^0.18.13",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9"
  }
}
