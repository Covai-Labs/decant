{
  "name": "decant",
  "version": "1.5.0",
  "description": "Fast, privacy-first Manifest V3 web clipper that decants articles and web pages into clean Markdown.",
  "main": ".output/chrome-mv3/background.js",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "postinstall": "wxt prepare",
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "npm run build && npm run build:firefox && python3 package.py"
  },
  "keywords": [
    "markdown",
    "web-clipper",
    "readability",
    "turndown",
    "extension",
    "manifest-v3",
    "obsidian"
  ],
  "author": "deadrat-in",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "decant-core": "latest",
    "jszip": "^3.10.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "wxt": "^0.21.4"
  }
}
