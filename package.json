{
  "name": "decant",
  "version": "1.0.0",
  "description": "Fast, privacy-first Manifest V3 web clipper that decants articles and web pages into clean Markdown.",
  "main": "dist/background.js",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "build:firefox": "node build.js --target=firefox",
    "watch": "node build.js --watch",
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "npm run build && npm run build:firefox && python3 package.py"
  },
  "keywords": [
    "markdown",
    "web-clipper",
    "readability",
    "turndown",
    "extension",
    "manifest-v3",
    "obsidian"
  ],
  "author": "Rat-S",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6"
  }
}
