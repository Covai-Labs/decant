{
  "manifest_version": 3,
  "name": "Decant - Web to Markdown Clipper",
  "version": "1.0.0",
  "description": "Fast, privacy-first web clipper that decants articles and webpages into clean Markdown.",
  "homepage_url": "https://decant.covai.org/",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "sidePanel",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Decant to Markdown",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/loader.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/content.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Open Decant popup"
    },
    "clip_tab_as_markdown": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Clip current tab as Markdown"
    },
    "copy_tab_as_markdown": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Copy current tab Markdown to clipboard"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
